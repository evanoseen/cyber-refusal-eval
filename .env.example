# API keys for cyber-refusal-eval. Copy this file to .env and fill in real values.
# .env is gitignored. Never commit it.

# Anthropic (judge calls). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me

# Together AI (open model inference). Get a key at api.together.xyz
TOGETHER_API_KEY=replace-me

# Fireworks AI (alternative open model inference). Get a key at fireworks.ai/account/api-keys
FIREWORKS_API_KEY=replace-me

# DeepInfra (only provider hosting all 3 locked models, including Mistral Large 2,
# which Together does not host). Get a key at deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=replace-me
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
